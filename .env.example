# The name of the remote configured in rclone
CLOUD_REMOTE_NAME=my_remote
# The destination path on the cloud storage
CLOUD_DEST_PATH=/backups/server
# The number of weeks to retain backups (if handled by your script)
RETENTION_WEEKS=4
# The cron schedule for the backup (e.g., "0 1 * * *" for daily at 1 AM)
BACKUP_CRON=0 1 * * *
# Timezone for the cron scheduler
TZ=UTC
# Hostname for backup identification
HOSTNAME=my_server
VM_NAME=my_server
# Source directory to backup
BACKUP_SOURCE_DIR=/home/mgrsys/DATA

# Space-separated list of Docker containers to pause during backup (optional)
# Example: CONTAINERS_TO_PAUSE="nextcloud-db plex"
CONTAINERS_TO_PAUSE=

# --- Email Alert Settings & Notification Policy ---
# Notification Policy Options:
#   on_failure - (Recommended) Send email ONLY when backup fails or errors occur (avoids daily spam)
#   weekly     - Send email on failures, plus one full summary report every Sunday
#   always     - Send email report after every single backup run
#   never      - Fully disable email alerts (monitor via Dozzle / Beszel / Uptime Kuma)
EMAIL_NOTIFY_MODE=on_failure

# URL for your SMTP server. Use smtps:// for port 465, or smtp:// for port 587
# Example: smtps://smtp.gmail.com:465
SMTP_URL=smtps://smtp.gmail.com:465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Rclone Configuration Injection ---
# Because Dockhand and some .env parsers break on multi-line text, we use Base64.
# Run this on your local machine to get the Base64 string:
#   cat rclone.conf | base64 -w 0
# Paste the resulting single-line string here:
RCLONE_CONF_BASE64=""

# --- Optional Config Password (AES-256 Encryption) ---
# If your rclone.conf is encrypted with a password (rclone config -> 's'),
# provide the decryption password here.
# Leave empty if your rclone.conf is in clear mode.
RCLONE_CONFIG_PASS=""

# --- Exclude Rules ---
# Customize exclude rules by copying exclude.txt.sample to exclude.txt:
#   cp exclude.txt.sample exclude.txt
# (exclude.txt is mounted directly into the container and ignored by git)

# --- Docker Network ---
# Shared Docker network for homelab containers (e.g. shared_net)
SHARED_NETWORK=shared_net
